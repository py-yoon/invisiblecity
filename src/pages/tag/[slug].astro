---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPosts, groupBy, tagSlug } from '../../lib/site';

export async function getStaticPaths() {
  return groupBy(await getPosts(), 'tags').map(([name, posts]) => ({
    params: { slug: tagSlug(name) },
    props: { name, posts },
  }));
}
const { name, posts } = Astro.props;
---
<Base title={name} description={`${name}  글 ${posts.length}편`}>
  <div class="with-sidebar">
    <div class="content">
      <h1 class="archive-title">태그: {name}</h1>
      <PostList posts={posts} />
    </div>
    <Sidebar />
  </div>
</Base>
