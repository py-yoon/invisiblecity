---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---
<Base title="검색">
  <link slot="head" rel="stylesheet" href={url('/pagefind/pagefind-ui.css')} />
  <div class="wrap-narrow list-head"><h1>검색</h1></div>
  <div class="wrap-narrow"><div id="search"></div></div>
  <script is:inline define:vars={{ src: url('/pagefind/pagefind-ui.js') }}>
    const s = document.createElement('script');
    s.src = src;
    s.onload = () => {
      const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, translations: { placeholder: '글 검색', zero_results: '[SEARCH_TERM]에 대한 결과가 없습니다' } });
      const q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
    };
    document.head.append(s);
  </script>
</Base>
