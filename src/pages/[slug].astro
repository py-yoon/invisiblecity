---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import shopData from '../data/shop.json';
import { getPosts, postSlug, postUrl, categoryUrl, categorySlug, tagUrl, fmtDate, withBase, url, tocOf, HUBS, hubOf } from '../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const pages = await getCollection('pages');
  return [
    ...posts.map((post, i) => ({
      params: { slug: postSlug(post) },
      props: { kind: 'post' as const, post, newer: posts[i - 1], older: posts[i + 1] },
    })),
    ...pages.map((page) => ({ params: { slug: page.id }, props: { kind: 'page' as const, page } })),
    ...HUBS.map((hub) => {
      const list = posts.filter((p) => hubOf(p) === hub);
      return { params: { slug: hub.slug }, props: { kind: 'hub' as const, hub, latest: list.slice(0, hub.take), older: list.slice(hub.take, hub.take + 20) } };
    }).filter((h) => h.props.latest.length),
  ];
}
const props = Astro.props;
// 쿠팡 파트너스 링크: 글 slug → 책 목록. 상품이 내려가면 src/data/shop.json 에서 바꾼다.
const shop: { name: string; url: string }[] = props.kind === 'post' ? (shopData as Record<string, { name: string; url: string }[]>)[postSlug(props.post)] ?? [] : [];
const hub =props.kind === 'post' ? hubOf(props.post) : undefined;
// 고정 페이지에 글 여러 편을 이어 붙일 때 글마다 h2 제목을 달고, 본문 소제목은 한 단계씩 내린다
const demote = (h: string) => h.replace(/<(\/?)h([2-5])\b/g, (_, sl, n) => `<${sl}h${+n + 1}`);
const html = props.kind === 'post' ? withBase(props.post.rendered?.html ?? '') : '';
const toc = tocOf(html);

// 검색엔진용 구조화 데이터 (Rank Math가 넣던 BlogPosting·BreadcrumbList)
const SITE = 'https://invisiblecity.co.kr';
let jsonld: object[] = [];
let article;
if (props.kind === 'post') {
  const d = props.post.data;
  const pageUrl = `${SITE}/${encodeURI(postSlug(props.post))}/`;
  article = { published: d.date, modified: d.updated, section: d.categories[0], tags: d.tags };
  jsonld = [
    {
      '@type': 'BlogPosting',
      headline: d.title,
      description: d.description,
      datePublished: d.date.toISOString(),
      dateModified: (d.updated ?? d.date).toISOString(),
      author: { '@type': 'Person', name: 'Wanbo', url: SITE },
      publisher: { '@type': 'Organization', name: '보이지않는도시연구소', url: SITE, logo: { '@type': 'ImageObject', url: `${SITE}/favicon.png` } },
      mainEntityOfPage: pageUrl,
      inLanguage: 'ko-KR',
      ...(d.cover ? { image: `${SITE}${d.cover}` } : {}),
      ...(d.categories[0] ? { articleSection: d.categories[0] } : {}),
      ...(d.tags.length ? { keywords: d.tags.join(', ') } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
        ...(d.categories[0] ? [{ '@type': 'ListItem', position: 2, name: d.categories[0], item: `${SITE}/category/${encodeURI(categorySlug(d.categories[0]))}/` }] : []),
        { '@type': 'ListItem', position: d.categories[0] ? 3 : 2, name: d.title, item: pageUrl },
      ],
    },
  ];
}
const updated = props.kind === 'post' && props.post.data.updated && fmtDate(props.post.data.updated) !== fmtDate(props.post.data.date)
  ? fmtDate(props.post.data.updated) : null;
---
{props.kind === 'post' ? (
  <Base title={props.post.data.title} description={props.post.data.description} image={props.post.data.cover && url(props.post.data.cover)} type="article" article={article} jsonld={jsonld} noindex={!!hub}>
    <article class="single">
      <h1 class="entry-title">{props.post.data.title}</h1>
      <p class="entry-dateline">
        <time datetime={props.post.data.date.toISOString()}>{fmtDate(props.post.data.date)}</time>
        {props.post.data.categories.map((c) => <> · <a href={categoryUrl(c)}>{c}</a></>)}
        {updated && <span class="updated"> · 수정 {updated}</span>}
        {props.post.data.draft && <span class="draft-badge">초안</span>}
      </p>
      {hub && <p class="hub-note">이 글은 그날 기준의 기록이다. 최신 내용은 <a href={url(`/${hub.slug}/`)}>{hub.title}</a>에서 볼 수 있다.</p>}
      {toc.length > 0 && (
        <nav class="toc" aria-label="목차">
          <p>목차</p>
          <ol>{toc.map((h) => <li class={`l${h.level}`}><a href={`#${h.id}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="entry-content" data-pagefind-body set:html={html} />
      {shop.length > 0 && (
        <aside class="shop" aria-label="관련 책">
          <p><strong>관련 책</strong></p>
          <ul>{shop.map((b) => <li><a href={b.url} target="_blank" rel="sponsored nofollow noopener">{b.name}</a></li>)}</ul>
          <p style="font-size:.8em;opacity:.7">이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.</p>
        </aside>
      )}
      <hr />
      <div class="entry-meta">
        <p class="author">Wanbo</p>
        <div>
          <p><a href={postUrl(props.post)}><time datetime={props.post.data.date.toISOString()}>{fmtDate(props.post.data.date)}</time></a></p>
          {props.post.data.categories.length > 0 && (
            <p>{props.post.data.categories.map((c, i) => <>{i > 0 && ', '}<a href={categoryUrl(c)}>{c}</a></>)}</p>
          )}
          {props.post.data.tags.length > 0 && (
            <p>{props.post.data.tags.map((t, i) => <>{i > 0 && ', '}<a href={tagUrl(t)}>{t}</a></>)}</p>
          )}
        </div>
      </div>
      <hr />
      <nav class="post-nav" aria-label="이전·다음 글">
        {props.older ? <a href={postUrl(props.older)} title={props.older.data.title}>이전</a> : <span />}
        {props.newer ? <a href={postUrl(props.newer)} title={props.newer.data.title}>다음</a> : <span />}
      </nav>
      <hr />
    </article>
  </Base>
) : props.kind === 'hub' ? (
  <Base title={props.hub.title} description={props.hub.description}>
    <article class="single">
      <h1 class="entry-title">{props.hub.title}</h1>
      <p class="entry-dateline">갱신 <time datetime={props.latest[0].data.date.toISOString()}>{fmtDate(props.latest[0].data.date)}</time></p>
      <p>{props.hub.description}</p>
      {props.latest.map((p) => (
        props.hub.take > 1
          ? <section><h2><a href={postUrl(p)}>{p.data.title}</a></h2><div class="entry-content" set:html={demote(withBase(p.rendered?.html ?? ''))} /></section>
          : <div class="entry-content" set:html={withBase(p.rendered?.html ?? '')} />
      ))}
      {props.older.length > 0 && (
        <>
          <h2>지난 기록</h2>
          <ul class="recent">{props.older.map((p) => <li><a href={postUrl(p)}>{p.data.title}</a> <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time></li>)}</ul>
        </>
      )}
    </article>
  </Base>
) : (
  <Base title={props.page.data.title}>
    <article class="single wide">
      <h1 class="entry-title">{props.page.data.title}</h1>
      <div class="entry-content page-raw" data-pagefind-body set:html={withBase(props.page.body ?? '')} />
    </article>
  </Base>
)}
