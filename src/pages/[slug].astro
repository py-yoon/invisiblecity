---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, postSlug, postUrl, categoryUrl, tagUrl, fmtDate, withBase, url, type Post } from '../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const pages = await getCollection('pages');
  return [
    ...posts.map((post, i) => ({
      params: { slug: postSlug(post) },
      props: { kind: 'post' as const, post, newer: posts[i - 1], older: posts[i + 1], all: posts },
    })),
    ...pages.map((page) => ({ params: { slug: page.id }, props: { kind: 'page' as const, page } })),
  ];
}

const props = Astro.props;
let related: Post[] = [];
if (props.kind === 'post') {
  const { categories, tags } = props.post.data;
  related = props.all
    .filter((p) => p !== props.post)
    .map((p) => ({ p, score: p.data.tags.filter((t) => tags.includes(t)).length * 2 + p.data.categories.filter((c) => categories.includes(c)).length }))
    .filter((x) => x.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, 3)
    .map((x) => x.p);
}
---
{props.kind === 'post' ? (
  <Base title={props.post.data.title} description={props.post.data.description} image={props.post.data.cover && url(props.post.data.cover)} type="article">
    <article class="post">
      <header class="wrap-narrow post-head">
        <div class="post-cats">
          {props.post.data.categories.map((c) => <a class="eyebrow" href={categoryUrl(c)}>{c}</a>)}
        </div>
        <h1>{props.post.data.title}</h1>
        <p class="post-meta">
          <time datetime={props.post.data.date.toISOString()}>{fmtDate(props.post.data.date)}</time>
          {props.post.data.updated && fmtDate(props.post.data.updated) !== fmtDate(props.post.data.date) && (
            <span> · 수정 {fmtDate(props.post.data.updated)}</span>
          )}
          {props.post.data.draft && <span class="badge">초안</span>}
        </p>
      </header>
      <div class="wrap-narrow prose" data-pagefind-body set:html={withBase(props.post.rendered?.html ?? '')} />
      {props.post.data.tags.length > 0 && (
        <footer class="wrap-narrow post-tags">
          {props.post.data.tags.map((t) => <a href={tagUrl(t)}>#{t}</a>)}
        </footer>
      )}
    </article>
    <nav class="wrap-narrow post-nav" aria-label="이전·다음 글">
      {props.older ? <a href={postUrl(props.older)}><small>이전 글</small>{props.older.data.title}</a> : <span />}
      {props.newer ? <a class="next" href={postUrl(props.newer)}><small>다음 글</small>{props.newer.data.title}</a> : <span />}
    </nav>
    {related.length > 0 && (
      <section class="wrap related">
        <h2>함께 읽을 글</h2>
        <div class="grid">{related.map((p) => <PostCard post={p} />)}</div>
      </section>
    )}
  </Base>
) : (
  <Base title={props.page.data.title}>
    <div class="wrap post-head">
      <h1>{props.page.data.title}</h1>
    </div>
    <div class="wrap page-raw prose" data-pagefind-body set:html={withBase(props.page.body ?? '')} />
  </Base>
)}
