---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPosts, postSlug, postUrl, categoryUrl, tagUrl, fmtDate, withBase, url } from '../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const pages = await getCollection('pages');
  return [
    ...posts.map((post, i) => ({
      params: { slug: postSlug(post) },
      props: { kind: 'post' as const, post, newer: posts[i - 1], older: posts[i + 1] },
    })),
    ...pages.map((page) => ({ params: { slug: page.id }, props: { kind: 'page' as const, page } })),
  ];
}
const props = Astro.props;
---
{props.kind === 'post' ? (
  <Base title={props.post.data.title} description={props.post.data.description} image={props.post.data.cover && url(props.post.data.cover)} type="article">
    <article class="single">
      <h1 class="entry-title">{props.post.data.title}</h1>
      {props.post.data.draft && <p class="draft-badge">초안</p>}
      <div class="entry-content" data-pagefind-body set:html={withBase(props.post.rendered?.html ?? '')} />
      <hr />
      <div class="entry-meta">
        <p class="author">Wanbo</p>
        <div>
          <p><a href={postUrl(props.post)}><time datetime={props.post.data.date.toISOString()}>{fmtDate(props.post.data.date)}</time></a></p>
          {props.post.data.categories.length > 0 && (
            <p>{props.post.data.categories.map((c, i) => <>{i > 0 && ', '}<a href={categoryUrl(c)}>{c}</a></>)}</p>
          )}
          {props.post.data.tags.length > 0 && (
            <p>{props.post.data.tags.map((t, i) => <>{i > 0 && ', '}<a href={tagUrl(t)}>{t}</a></>)}</p>
          )}
        </div>
      </div>
      <hr />
      <nav class="post-nav" aria-label="이전·다음 글">
        {props.older ? <a href={postUrl(props.older)} title={props.older.data.title}>이전</a> : <span />}
        {props.newer ? <a href={postUrl(props.newer)} title={props.newer.data.title}>다음</a> : <span />}
      </nav>
      <hr />
    </article>
  </Base>
) : (
  <Base title={props.page.data.title}>
    <article class="single">
      <h1 class="entry-title">{props.page.data.title}</h1>
      <div class="entry-content page-raw" data-pagefind-body set:html={withBase(props.page.body ?? '')} />
    </article>
  </Base>
)}
