---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESC, url } from '../lib/site';

interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article' }
const { title, description = SITE_DESC, image, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} - ${SITE_TITLE}` : `${SITE_TITLE} - ${SITE_DESC}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
const nav = [
  ['/', '글'],
  ['/am/', '건축지도'],
  ['/wm/', '세계 건축지도'],
  ['/tools-2/', '도구'],
  ['/link/', '링크'],
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.png')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={url('/')}>
          <img class="brand-mark" src={url("/favicon.png")} alt="" width="40" height="40" />
          <span class="brand-text"><strong>invisiblecity</strong><span>보이지 않는 도시연구소</span></span>
        </a>
        <nav class="nav" aria-label="주 메뉴">
          {nav.map(([href, label]) => (
            <a href={url(href)} aria-current={(href === '/' ? path === '/' || path.startsWith('/page/') : path.startsWith(href)) ? 'page' : undefined}>{label}</a>
          ))}
          <a class="nav-search" href={url('/search/')} aria-label="검색">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>
          <strong>invisiblecity</strong>
          <p>도시를 바꾸는 개발사업, 건축, 부동산 제도를 기록합니다.</p>
        </div>
        <div class="footer-links">
          <a href={url('/categories/')}>카테고리</a>
          <a href={url('/tags/')}>태그</a>
          <a href={url('/rss.xml')}>RSS</a>
          <a href="https://www.youtube.com/@_wanbo">유튜브</a>
        </div>
      </div>
      <div class="wrap copyright">© {new Date().getFullYear()} invisiblecity.co.kr</div>
    </footer>
  </body>
</html>
