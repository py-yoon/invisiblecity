---
import '../styles/global.css';
import SearchForm from '../components/SearchForm.astro';
import { SITE_TITLE, SITE_DESC, url, getPosts, groupBy, postUrl, categoryUrl, fmtShortDate } from '../lib/site';

interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article' }
const { title, description = SITE_DESC, image, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} - ${SITE_TITLE}` : `${SITE_TITLE} - ${SITE_DESC}`;
// 미리보기(github.io)는 검색에 안 잡히게 하고, 대표 주소는 항상 실제 도메인으로
const REAL_SITE = 'https://invisiblecity.co.kr';
const isPreview = Astro.site?.origin !== REAL_SITE;
const canonical = new URL(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/', REAL_SITE);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const nav = [
  ['/am/', '건축지도'],
  ['/wm/', '세계 건축지도'],
  ['/tools-2/', '부동산 계산기'],
  ['/tools/', '평 환산기'],
  ['/page/', '참고 사이트'],
  ['/link/', '링크'],
];
const posts = await getPosts();
const categories = groupBy(posts, 'categories').map(([n]) => n).sort((a, b) => a.localeCompare(b, 'ko'));
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={url('/favicon.png')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="preload" href={url('/fonts/Poppins-Regular.woff2')} as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <style is:inline set:html={['Regular:400', 'Medium:500', 'SemiBold:600', 'Bold:700', 'Black:900'].map((f) => {
      const [name, weight] = f.split(':');
      return `@font-face{font-family:Poppins;font-weight:${weight};font-style:normal;font-display:swap;src:url('${url(`/fonts/Poppins-${name}.woff2`)}') format('woff2')}`;
    }).join('')} />
    <slot name="head" />
  </head>
  <body>
    <div class="top-bar"><p>보이지않는도시연구소</p></div>
    <header class="site-header">
      <div class="site-title"><a href={url('/')}>invisiblecity</a></div>
      <div class="nav-wrap">
        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="nav-button" aria-label="메뉴 열기"><span></span><span></span><span></span></label>
        <nav aria-label="메뉴">
          {nav.map(([href, label]) => <a href={url(href)} aria-current={Astro.url.pathname === url(href) ? 'page' : undefined}>{label}</a>)}
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-widgets">
        <section>
          <h2>About</h2>
          <p>보이지 않는 도시연구소</p>
          <SearchForm />
        </section>
        <section>
          <h2>Posts</h2>
          <ul class="footer-posts">
            {posts.slice(0, 3).map((p) => (
              <li><a href={postUrl(p)}>{p.data.title}</a><time datetime={p.data.date.toISOString()}>{fmtShortDate(p.data.date)}</time></li>
            ))}
          </ul>
        </section>
        <section>
          <h2>Category</h2>
          <ul class="footer-cats">
            {categories.map((c) => <li><a href={categoryUrl(c)}>{c}</a></li>)}
          </ul>
        </section>
      </div>
      <div class="copyright">© {new Date().getFullYear()} invisiblecity</div>
    </footer>
    <a class="back-to-top" href="#" aria-label="맨 위로">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <script is:inline>
      const btn = document.querySelector('.back-to-top');
      addEventListener('scroll', () => btn.classList.toggle('show', scrollY > 300), { passive: true });
    </script>
  </body>
</html>
