---
import '../styles/global.css';
import SearchForm from '../components/SearchForm.astro';
import { SITE_TITLE, SITE_DESC, url, getPosts, groupBy, isFeed, postUrl, categoryUrl, fmtShortDate } from '../lib/site';

interface Article { published: Date; modified?: Date; section?: string; tags: string[] }
interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; noindex?: boolean; article?: Article; jsonld?: object[] }
const { title, description = SITE_DESC, image, type = 'website', noindex = false, article, jsonld = [] } = Astro.props;
const fullTitle = title ? `${title} - ${SITE_TITLE}` : `${SITE_TITLE} - ${SITE_DESC}`;
// 미리보기(github.io)는 검색에 안 잡히게 하고, 대표 주소는 항상 실제 도메인으로
const REAL_SITE = 'https://invisiblecity.co.kr';
const isPreview = Astro.site?.origin !== REAL_SITE;
// 워드프레스와 똑같이 퍼센트 인코딩은 소문자(%eb…)로
const canonical = new URL(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/', REAL_SITE)
  .href.replace(/%[0-9A-F]{2}/g, (m) => m.toLowerCase());
// 대표 이미지가 없는 페이지(홈·소개·계산기·목록)는 사이트 공통 이미지로 공유 미리보기를 채운다.
const ogImage = new URL(image ?? '/og.png', Astro.site).href;
// 메뉴: 만든 사이트 묶음, 카테고리 세 묶음, 계산기. 글이 있는 카테고리만 보이고,
// 새로 생긴 카테고리는 마지막 묶음 끝에 붙는다.
type MenuItem = [href: string, label: string];
const SITES: MenuItem[] = [
  [url('/factory/'), '공장용지 지도'],
  ['https://retrack.invisiblecity.co.kr/', '서울 재개발·재건축'],
  [url('/architect'), '건축, 걷다'],
  [url('/nimby/'), '전국 기피시설 지도'],
  [url('/spire/'), 'SPIRE 세계 최고층 빌딩'],
  [url('/underground/'), '땅 아래 대한민국'],
  [url('/am/'), '건축지도'],
];
const CATEGORY_GROUPS: [string, string[]][] = [
  ['개발사업', ['도시를 바꾸는 개발사업', '도시개발사업', '산업단지', '지구단위계획', '도시정비사업']],
  ['청약·분양', ['청약 결과', '분양 일정']],
  ['부동산·제도', ['주택사업', '부담금/세금', '부동산', '지식산업센터']],
  ['도시·건축', ['해외건축가', '국내건축가', '도시기반시설', '인프라시설', '도시정책/통계', '도시산책']],
];
const posts = await getPosts();
const catCount = new Map(groupBy(posts, 'categories').map(([n, ps]) => [n, ps.length]));
const categories = [...catCount.keys()].sort((a, b) => a.localeCompare(b, 'ko'));
const grouped = new Set(CATEGORY_GROUPS.flatMap(([, cs]) => cs));
const menu: [string, MenuItem[]][] = [
  ['Sites', SITES],
  ...CATEGORY_GROUPS.map(([label, cs], i): [string, MenuItem[]] => [
    label,
    [...cs, ...(i === CATEGORY_GROUPS.length - 1 ? categories.filter((c) => !grouped.has(c)) : [])]
      .filter((c) => categories.includes(c))
      .map((c): MenuItem => [categoryUrl(c), c]),
  ]),
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={isPreview ? 'noindex, nofollow' : noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large'} />
    {!isPreview && (
      <>
        <meta name="naver-site-verification" content="9c751a75167a24abd8cd503ceabd5d2edac50c72" />
        {/* Site Kit이 하던 것: 유럽 방문자는 동의 전까지 광고·분석 저장 거부(동의 모드) */}
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('consent', 'default', {
            ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied',
            region: ['AT','BE','BG','CY','CZ','DE','DK','EE','ES','FI','FR','GB','GR','HR','HU','IE','IS','IT','LI','LT','LU','LV','MT','NL','NO','PL','PT','RO','SE','SI','SK','CH'],
          });
          gtag('js', new Date());
          gtag('config', 'GT-NCLZN88');
        </script>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=GT-NCLZN88"></script>
        <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3661100956787514" crossorigin="anonymous"></script>
      </>
    )}
    <link rel="icon" href={url('/favicon.png')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="preload" href={url('/fonts/Poppins-Regular.woff2')} as="font" type="font/woff2" crossorigin />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="보이지않는도시연구소" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {article && (
      <>
        {article.tags.map((t) => <meta property="article:tag" content={t} />)}
        {article.section && <meta property="article:section" content={article.section} />}
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
      </>
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {jsonld.length > 0 && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonld.length === 1 ? jsonld[0] : { '@context': 'https://schema.org', '@graph': jsonld })} />}
    <style is:inline set:html={['Regular:400', 'Medium:500', 'SemiBold:600', 'Bold:700', 'Black:900'].map((f) => {
      const [name, weight] = f.split(':');
      return `@font-face{font-family:Poppins;font-weight:${weight};font-style:normal;font-display:swap;src:url('${url(`/fonts/Poppins-${name}.woff2`)}') format('woff2')}`;
    }).join('')} />
    <slot name="head" />
  </head>
  <body>
    <div class="top-bar"><p>보이지않는도시연구소</p></div>
    <header class="site-header">
      <div class="site-title"><a href={url('/')}>invisiblecity</a></div>
      <div class="nav-wrap">
        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="nav-button" aria-label="메뉴 열기"><span></span><span></span><span></span></label>
        <nav aria-label="메뉴">
          {menu.map(([label, items]) => (
            <div class="menu-group">
              <button type="button" class="menu-top" aria-expanded="false">{label}</button>
              <ul class="submenu">
                {items.map(([href, text]) => <li><a href={href}>{text}</a></li>)}
              </ul>
            </div>
          ))}
          <a class="menu-top" href={url('/tools-2/')}>계산기</a>
          <a class="menu-top menu-search" href={url('/search/')} aria-label="검색">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
            <span class="menu-search-label">검색</span>
          </a>
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-widgets">
        <section>
          <h2>About</h2>
          <p class="footer-intro">보이지 않는 도시연구소는 도시를 바꾸는 개발사업, 건축, 부동산 제도와 통계를 기록합니다.<br /><a class="footer-about" href={url('/about/')}>소개 · 참고 사이트 →</a></p>
          <SearchForm />
          <h3 class="footer-sub">Sites</h3>
          <ul class="footer-sites">
            {SITES.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
          </ul>
          <h3 class="footer-sub">Follow</h3>
          <p class="footer-follow">
            <a href="https://www.youtube.com/@_wanbo">YouTube</a>
            <a href={url('/rss.xml')}>RSS</a>
          </p>
        </section>
        <section>
          <h2>Posts</h2>
          <ul class="footer-posts">
            {posts.filter((p) => !isFeed(p)).slice(0, 10).map((p) => (
              <li><a href={postUrl(p)}>{p.data.title}</a><time datetime={p.data.date.toISOString()}>{fmtShortDate(p.data.date)}</time></li>
            ))}
          </ul>
        </section>
        <section>
          <h2>Category</h2>
          <ul class="footer-cats">
            {categories.map((c) => <li><a href={categoryUrl(c)}>{c}</a> ({catCount.get(c)})</li>)}
          </ul>
        </section>
      </div>
      <div class="copyright">© {new Date().getFullYear()} invisiblecity · <a href={url('/privacy/')}>개인정보처리방침</a></div>
    </footer>
    <a class="back-to-top" href="#" aria-label="맨 위로">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <script is:inline>
      const btn = document.querySelector('.back-to-top');
      addEventListener('scroll', () => btn.classList.toggle('show', scrollY > 300), { passive: true });
      document.querySelectorAll('.menu-group > .menu-top').forEach((b) => b.addEventListener('click', () => {
        const open = b.getAttribute('aria-expanded') !== 'true';
        document.querySelectorAll('.menu-group > .menu-top').forEach((o) => o.setAttribute('aria-expanded', 'false'));
        b.setAttribute('aria-expanded', String(open));
      }));
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.menu-group')) document.querySelectorAll('.menu-group > .menu-top').forEach((o) => o.setAttribute('aria-expanded', 'false'));
      });
    </script>
  </body>
</html>
