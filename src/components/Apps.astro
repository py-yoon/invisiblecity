---
import { url } from '../lib/site';
// 첫 화면의 '만든 사이트' 카드. 블로그 밖 주소는 절대 주소로 둔다.
const apps = [
  { href: url('/factory/'), name: 'FACTORY MAP', title: '공장용지 지도', stat: '1,476', unit: '곳', desc: '전국 산업단지의 분양 상태·미분양 면적·분양가. 매주 갱신.', tone: 'pink' },
  { href: 'https://retrack.invisiblecity.co.kr/', name: 'RETRACK', title: '서울 재개발·재건축', stat: '874', unit: '곳', desc: '서울 재개발·재건축 구역의 진행단계, 민간개발과 시세 흐름.', tone: 'purple' },
  { href: url('/architect'), name: 'ARCHITECT', title: '건축, 걷다', stat: '772', unit: '곳', desc: '한국·일본 근대·현대 건축과 걸어서 도는 답사 코스.', tone: 'yellow' },
  { href: url('/nimby/'), name: 'NIMBY MAP', title: '전국 기피시설 지도', stat: '1만', unit: '여 곳', desc: '소각장·하수처리장·화장장 등을 우리 동네 반경으로 검색.', tone: 'white' },
  { href: url('/spire/'), name: 'SPIRE', title: '세계 최고층 빌딩 도감', stat: '108', unit: '동', desc: '300m 이상 초고층을 같은 축척으로 세워 비교.', tone: 'pink' },
];
---
<section class="apps" aria-labelledby="apps-title">
  <h2 id="apps-title">Sites</h2>
  <ul>
    {apps.map((a) => (
      <li class={`app ${a.tone}`}>
        <a href={a.href}>
          <span class="app-top">
            <span class="app-name">{a.name}</span>
            <span class="app-title">{a.title}</span>
          </span>
          <span class="app-desc">{a.desc}</span>
          <span class="app-foot">
            <span class="app-stat">{a.stat}<small>{a.unit}</small></span>
            <span class="app-go" aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
