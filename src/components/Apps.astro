---
import { url } from '../lib/site';
// 첫 화면의 '만든 사이트' 카드. 블로그 밖 주소는 절대 주소로 둔다.
const apps = [
  { href: url('/spire/'), name: 'SPIRE', title: '세계 최고층 빌딩 도감', desc: '300m 이상 초고층 108동을 같은 축척으로 세워 비교합니다. 측정 기준별 순위·지도·연표.', tone: 'pink' },
  { href: url('/nimby/'), name: 'NIMBY MAP', title: '전국 기피시설 지도', desc: '소각장·하수처리장·화장장·변전소 등 1만여 곳. 우리 동네 반경 안의 시설을 찾아봅니다.', tone: 'purple' },
  { href: url('/factory/'), name: 'FACTORY MAP', title: '공장용지 지도', desc: '전국 산업단지 1,476곳의 분양 상태·미분양 면적·분양가·유치업종을 지도에서 찾습니다. 매주 갱신.', tone: 'white' },
  { href: 'https://retrack.invisiblecity.co.kr/', name: 'RETRACK', title: '서울 재개발·재건축 현황', desc: '서울 정비사업 진행 단계와 민간개발, 인구·시세 흐름을 지도와 표로 한눈에 봅니다.', tone: 'yellow' },
];
---
<section class="apps" aria-labelledby="apps-title">
  <h2 id="apps-title">Sites</h2>
  <ul>
    {apps.map((a) => (
      <li class={`app ${a.tone}`}>
        <a href={a.href}>
          <span class="app-name">{a.name}</span>
          <span class="app-title">{a.title}</span>
          <span class="app-desc">{a.desc}</span>
          <span class="app-go">바로가기 →</span>
        </a>
      </li>
    ))}
  </ul>
</section>
