---
import { type Post, postUrl, categoryUrl, fmtDate, url } from '../lib/site';
interface Props { post: Post; feature?: boolean }
const { post, feature = false } = Astro.props;
const { title, date, categories, tags, description, cover } = post.data;
---
<article class:list={['card', { feature }]}>
  <a class="card-thumb" href={postUrl(post)} tabindex="-1" aria-hidden="true">
    {cover ? <img src={url(cover)} alt="" loading="lazy" decoding="async" /> : <span class="thumb-empty">
      <span class="thumb-cat">{categories[0] ?? 'invisiblecity'}</span>
      <span class="thumb-tags">{(tags.length ? tags.slice(0, 3) : [title]).map((t) => <span>{tags.length ? `#${t}` : t}</span>)}</span>
    </span>}
  </a>
  <div class="card-body">
    {categories[0] && <a class="eyebrow" href={categoryUrl(categories[0])}>{categories[0]}</a>}
    <h2 class="card-title"><a href={postUrl(post)}>{title}</a></h2>
    <p class="card-desc">{description}</p>
    <time datetime={date.toISOString()}>{fmtDate(date)}</time>
  </div>
</article>
