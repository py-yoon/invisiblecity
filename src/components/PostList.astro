---
import { type Post, postUrl, fmtDate, url, excerptOf } from '../lib/site';
interface Props { posts: Post[]; page?: number; pages?: number; basePath?: string }
const { posts, page = 1, pages = 1, basePath = '/' } = Astro.props;
const pageHref = (n: number) => url(n === 1 ? basePath : `${basePath}page/${n}/`);
---
<ul class="post-list">
  {posts.map((p) => (
    <li>
      <h2><a href={postUrl(p)}>{p.data.title}</a></h2>
      <p class="excerpt">{excerptOf(p)}</p>
      <p><a href={postUrl(p)}>Read more...</a></p>
      <p class="date"><a href={postUrl(p)}><time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time></a></p>
    </li>
  ))}
</ul>
{pages > 1 && (
  <nav class="pagination" aria-label="페이지 매김">
    {page > 1 && <a href={pageHref(page - 1)}>이전 페이지</a>}
    {page < pages && <a href={pageHref(page + 1)}>다음 페이지</a>}
  </nav>
)}
