// Cloudflare Workers 정적 사이트 설정: pnpm build로 만든 dist/를 그대로 올린다.
// _redirects(옛 워드프레스 주소)와 404.html도 여기서 처리된다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invisiblecity",
  "compatibility_date": "2026-10-01",
  // Worker 코드(worker/index.js)는 아래 run_worker_first 에 적은 경로에서만 돈다: /spire·/nimby·/factory·/architect 프록시, /retrack 리다이렉트.
  // 나머지(블로그 글·이미지·_redirects·404)는 Worker 를 거치지 않고 정적 파일로 바로 나간다 — 무료 한도(하루 Worker 호출 10만 건)에 안 잡힌다.
  // 그래서 http→https 와 www→apex 는 Worker 가 아니라 Cloudflare 도메인 설정(Always Use HTTPS, Redirect Rule)이 맡는다.
  "main": "worker/index.js",
  // 실제 도메인 연결. 배포할 때 Cloudflare가 DNS 기록과 인증서를 자동으로 만든다.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "invisiblecity.co.kr", "custom_domain": true },
    { "pattern": "www.invisiblecity.co.kr", "custom_domain": true },
    // 옛 기피시설 지도 주소. worker 가 /nimby/ 로 보낸다(예전에는 Vercel 이 하던 리다이렉트).
    { "pattern": "nimby.invisiblecity.co.kr", "custom_domain": true }
  ],
  // /nimby·/factory 는 같은 계정의 정적 Worker 를 직접 부른다(공개 주소 없음).
  "services": [
    { "binding": "NIMBY", "service": "ghmun-nimby-map" },
    { "binding": "FACTORY", "service": "factory-map" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // "/spire*" 처럼 쓰면 /spire-세계-최고층-빌딩-도감 같은 글 주소까지 잡히므로 정확한 경로와 그 아래(/*)만 적는다.
    "run_worker_first": [
      "/spire", "/spire/*", "/nimby", "/nimby/*", "/factory", "/factory/*",
      "/architect", "/architect/*", "/retrack", "/retrack/*", "/a063e951082ad4c6/*"
    ],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
