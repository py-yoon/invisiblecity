// Cloudflare Workers 정적 사이트 설정: pnpm build로 만든 dist/를 그대로 올린다.
// _redirects(옛 워드프레스 주소)와 404.html도 여기서 처리된다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invisiblecity",
  "compatibility_date": "2026-10-01",
  // 모든 요청이 Worker 코드(worker/index.js)를 먼저 거친다: http·www 리다이렉트, /spire·/nimby·/factory·/architect 프록시, 나머지는 정적 파일(ASSETS).
  "main": "worker/index.js",
  // 실제 도메인 연결. 배포할 때 Cloudflare가 DNS 기록과 인증서를 자동으로 만든다.
  "routes": [
    { "pattern": "invisiblecity.co.kr", "custom_domain": true },
    { "pattern": "www.invisiblecity.co.kr", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
